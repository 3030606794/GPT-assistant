<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Dark mode liquid glass: darker base + brighter specular so selection is obvious -->

    <!-- Base (dark translucent) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#662A2F3A"
                android:centerColor="#8830384A"
                android:endColor="#6630384A"
                android:type="linear" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!-- Specular highlight (top-left) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.22"
                android:centerY="0.18"
                android:gradientRadius="70dp"
                android:startColor="#66FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!-- Edge refraction -->
    <item android:right="52dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#55FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <item android:left="52dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="180"
                android:startColor="#44FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!-- Border (bright hairline) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>

</layer-list>
