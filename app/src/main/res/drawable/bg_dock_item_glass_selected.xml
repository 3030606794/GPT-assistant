<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        v13 Liquid Glass (Dock selection indicator)
        Goal: remove ANY visible bottom shadow / grey halo. Keep only refraction + specular highlights.
        IMPORTANT: no dark gradients, no drop shadows.
    -->

    <!-- Glass base: slightly stronger so the selected state is clearly visible on the frosted dock -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#F2F7FBFF"
                android:centerColor="#D9FFFFFF"
                android:endColor="#99FFFFFF"
                android:type="linear" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!-- Primary specular (top-left) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.22"
                android:centerY="0.16"
                android:gradientRadius="66dp"
                android:startColor="#FFFFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!-- Secondary specular (top-right) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.86"
                android:centerY="0.22"
                android:gradientRadius="90dp"
                android:startColor="#B3FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!-- Left refraction edge -->
    <item android:right="52dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#B8FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!-- Right refraction edge -->
    <item android:left="52dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="180"
                android:startColor="#A0FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!-- Diagonal shimmer (kept subtle to avoid any perceived "shadow") -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#42FFFFFF"
                android:centerColor="#10FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!-- Top glossy band -->
    <item android:bottom="18dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FFFFFFFF"
                android:centerColor="#66FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!-- Subtle border to separate the pill from the dock (no shadow, no white rim) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#22000000" />
            <corners android:radius="18dp" />
        </shape>
    </item>

</layer-list>
