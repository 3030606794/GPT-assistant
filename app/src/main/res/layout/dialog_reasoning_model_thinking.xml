<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_reasoning_model_thinking_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical" />

    <TextView
        android:id="@+id/tv_reasoning_persona_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingHorizontal="12dp"
        android:paddingBottom="6dp"
        android:text="💡 切换不同角色会智能覆盖此参数"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:alpha="0.85"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/ll_reasoning_anim_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start|center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="6dp">

        <Button
            android:id="@+id/btn_reasoning_animation_mode"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:text="动画选择：逐格充能"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_reasoning_animation_toggle"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minHeight="0dp"
            android:text="关闭动画"
            android:textAllCaps="false" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_reasoning_anim_speed_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start|center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="动画速度（周期倍率）"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_reasoning_anim_speed_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="100%（周期倍率）"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold"
            android:textSize="12sp" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/seek_reasoning_anim_speed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:max="100"
        android:progress="70" />

</LinearLayout>
