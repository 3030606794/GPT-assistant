<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_interrupt_ai_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_interrupt_ai_enable_gesture" />

        <TextView
            android:id="@+id/tv_interrupt_ai_enabled_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ui_interrupt_ai_enable_desc"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ui_interrupt_ai_gesture_type"
            android:textStyle="bold"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />

        <RadioGroup
            android:id="@+id/rg_interrupt_gesture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rb_interrupt_gesture_bangbang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_interrupt_ai_gesture_bangbang" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rb_interrupt_gesture_stop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_interrupt_ai_gesture_stop" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rb_interrupt_gesture_double_space"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_interrupt_ai_gesture_double_space" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rb_interrupt_gesture_double_backspace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_interrupt_ai_gesture_double_backspace" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rb_interrupt_gesture_custom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_interrupt_ai_gesture_custom" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_interrupt_custom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:visibility="gone"
                android:hint="@string/ui_interrupt_ai_custom_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_interrupt_custom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

        </RadioGroup>

        <TextView
            android:id="@+id/tv_interrupt_ai_gesture_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ui_interrupt_ai_gesture_desc"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ui_interrupt_ai_mode"
            android:textStyle="bold"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />

        <RadioGroup
            android:id="@+id/rg_interrupt_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rb_interrupt_mode_soft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_interrupt_ai_mode_soft" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rb_interrupt_mode_hard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_interrupt_ai_mode_hard" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rb_interrupt_mode_both"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_interrupt_ai_mode_both" />

        </RadioGroup>

        <TextView
            android:id="@+id/tv_interrupt_ai_mode_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ui_interrupt_ai_mode_desc"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/tv_interrupt_ai_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ui_interrupt_ai_hint"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

    </LinearLayout>
</ScrollView>
