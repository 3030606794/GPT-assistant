<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Module 1: Emoji identity + role name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_role_emoji"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="🤖"
            android:textSize="18sp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_role_emoji"
            android:foreground="?attr/selectableItemBackgroundBorderless" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_role_name"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"
            android:backgroundTint="?attr/colorSurfaceContainerHigh"
            android:hint="@string/role_name_hint"
            android:paddingHorizontal="16dp"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:textSize="14sp" />

    </LinearLayout>

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/et_role_trigger"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input_field"
        android:backgroundTint="?attr/colorSurfaceContainerHigh"
        android:hint="@string/role_trigger_hint"
        android:maxLength="10"
        android:paddingHorizontal="16dp"
        android:textColor="?attr/colorOnSurface"
        android:textColorHint="?attr/colorOnSurfaceVariant"
        android:textSize="14sp" />

    <!-- Module 2: Dynamic chips toolbar (insert variables at cursor) -->
    <HorizontalScrollView
        android:id="@+id/hsv_role_vars"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/ll_role_var_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <!-- Module 3: Immersive prompt input + token estimator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_role_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_field"
            android:backgroundTint="?attr/colorSurfaceContainerHigh"
            android:hint="@string/role_prompt_hint"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:minLines="5"
            android:maxLines="12"
            android:nestedScrollingEnabled="true"
            android:scrollbars="vertical"
            android:overScrollMode="ifContentScrolls"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_token_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="10dp"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="11sp"
            android:text="0 字 / 约 0 Tokens" />

    </LinearLayout>

    <!-- Module 3.5: Few-shot examples (optional) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="示例输入（可选）"
        android:textColor="?attr/colorOnSurface"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="可用于 Few-shot 示例：示例输入=用户，示例输出=助手。会拼接进 System Prompt，用于影响风格/格式（非强制）。"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/et_role_example_user"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_field"
        android:backgroundTint="?attr/colorSurfaceContainerHigh"
        android:hint="例如：请把下面文本翻译成中文…"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:gravity="top|start"
        android:inputType="textMultiLine"
        android:minLines="2"
        android:maxLines="4"
        android:nestedScrollingEnabled="true"
        android:scrollbars="vertical"
        android:overScrollMode="ifContentScrolls"
        android:textColor="?attr/colorOnSurface"
        android:textColorHint="?attr/colorOnSurfaceVariant"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="示例输出（可选）"
        android:textColor="?attr/colorOnSurface"
        android:textSize="13sp" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/et_role_example_assistant"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_field"
        android:backgroundTint="?attr/colorSurfaceContainerHigh"
        android:hint="例如：当然可以，以下是翻译结果…"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:gravity="top|start"
        android:inputType="textMultiLine"
        android:minLines="2"
        android:maxLines="4"
        android:nestedScrollingEnabled="true"
        android:scrollbars="vertical"
        android:overScrollMode="ifContentScrolls"
        android:textColor="?attr/colorOnSurface"
        android:textColorHint="?attr/colorOnSurfaceVariant"
        android:textSize="13sp" />

    <!-- Module 4: Profile/Preset overrides (optional) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🧩 启用对话配置档案"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sw_role_preset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_role_preset_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/row_role_preset_memory"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input_field"
            android:backgroundTint="?attr/colorSurfaceContainerHigh"
            android:paddingHorizontal="16dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="对话记忆"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_role_preset_memory_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:gravity="end"
                android:text="跟随全局"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_role_preset_max_tokens"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_field"
            android:backgroundTint="?attr/colorSurfaceContainerHigh"
            android:paddingHorizontal="16dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="输出长度（Max Tokens）"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_role_preset_max_tokens_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:gravity="end"
                android:text="跟随全局"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

    </LinearLayout>

    <!-- Module 5: Parameter override -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚙️ 启用角色专属参数"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sw_role_override"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_role_override_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Override sub model -->
        <LinearLayout
            android:id="@+id/row_role_override_model"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input_field"
            android:backgroundTint="?attr/colorSurfaceContainerHigh"
            android:paddingHorizontal="16dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="专属大模型"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_role_override_model_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:gravity="end"
                android:text="跟随全局"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp"
                android:singleLine="true"
                android:ellipsize="end" />

        </LinearLayout>

        <!-- Override temperature -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="专属思考温度"
            android:textColor="?attr/colorOnSurface"
            android:textSize="13sp" />

        <!-- Dynamic description (updates as slider moves) -->
        <TextView
            android:id="@+id/tv_role_override_temp_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            android:maxLines="4"
            android:ellipsize="end"
            android:text="0.7【灵活生动】\n最推荐的日常聊天默认值。既不会死板，也不会乱跑题。适合：通用对话、生活建议、情感倾诉。" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_role_override_temp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0.0"
            android:valueTo="2.0"
            android:stepSize="0.1"
            android:value="0.7" />

    </LinearLayout>

</LinearLayout>
