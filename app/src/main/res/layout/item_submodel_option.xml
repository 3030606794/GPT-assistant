<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_submodel_item"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingHorizontal="12dp"
    android:paddingVertical="12dp">

    <!-- Top row: index + name + (custom-only actions) -->
    <LinearLayout
        android:id="@+id/row_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Left: index number for long-list locating -->
        <TextView
            android:id="@+id/tv_index"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <!-- Middle: model name -->
        <TextView
            android:id="@+id/tv_item"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <!-- Star / Favorite (always visible) -->
        <ImageView
            android:id="@+id/iv_star"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="10dp"
            android:padding="4dp"
            android:background="@drawable/bg_star_fav_highlight"
            android:src="@drawable/ic_star"
            android:contentDescription="@string/ui_collect"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:scaleType="centerInside"
            app:tint="?attr/colorOnSurfaceVariant" />

        <!-- Right: custom-only actions -->
        <LinearLayout
            android:id="@+id/row_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_edit"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="14dp"
                android:padding="4dp"
                android:src="@drawable/ic_edit"
                android:contentDescription="@string/ui_edit"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                app:tint="@null" />

            <ImageView
                android:id="@+id/iv_delete"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="14dp"
                android:padding="4dp"
                android:src="@drawable/ic_delete"
                android:contentDescription="@string/ui_delete"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                app:tint="?attr/colorError" />

        </LinearLayout>

    </LinearLayout>

    <!-- Tags container (chips), only visible when matched -->
    <LinearLayout
        android:id="@+id/row_tags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="36dp"
        android:orientation="horizontal"
        android:visibility="gone" />


    <TextView
        android:id="@+id/tv_capability_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="36dp"
        android:textSize="11sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:maxLines="2"
        android:ellipsize="end"
        android:visibility="gone" />

</LinearLayout>
