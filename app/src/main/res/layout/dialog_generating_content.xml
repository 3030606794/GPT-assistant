<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_gen_content_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_generating_content_enabled" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:boxBackgroundMode="outline"
            android:hint="@string/ui_generating_content_prefix">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_gen_content_prefix"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ui_generating_content_hint_use_default"
            android:textSize="12sp"
            android:alpha="0.7" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:boxBackgroundMode="outline"
            android:hint="@string/ui_generating_content_suffix">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_gen_content_suffix"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_gen_input_role_marker_master"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="输入框内动态显示角色名（总开关，纯文本）" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_gen_input_role_marker_suffix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingStart="12dp"
            android:text="光标后（回复中关键词）拼接角色名" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_gen_input_role_marker_prefix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingStart="12dp"
            android:text="AI 回复前（占位提示）拼接角色名" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="提示：开启总开关后，勾选“光标后/回复前”对应位置才会生效；占位符中可写 {role}（或 ${role}）来显示本次角色名。"
            android:textSize="12sp"
            android:alpha="0.7" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_gen_thinking_elapsed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="AI 正在思考后显示耗时" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_gen_reply_token_counter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="显示回复 Token 计数（独立标记）" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_gen_reply_token_counter_auto_remove"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:text="回复完成后自动删除 Token 计数" />

        <!-- Auto-remove delay (0-10s) -->
        <LinearLayout
            android:id="@+id/layout_gen_reply_token_counter_auto_remove_delay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingStart="24dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="自动删除延迟" />

                <TextView
                    android:id="@+id/tv_gen_reply_token_counter_auto_remove_delay_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0s"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_gen_reply_token_counter_auto_remove_delay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="0"
                android:valueTo="10"
                android:stepSize="1"
                app:labelBehavior="withinBounds" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="高级提示行为"
            android:textStyle="bold" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_gen_content_toast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Toast 提示（思考/回复）" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_gen_content_dynamic_prefix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="动态状态前缀（推理/代码嗅探）" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_gen_content_token_burner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Token 算力燃烧条" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_gen_content_standalone_float"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="独立悬浮条（KGPT 实验室）" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="独立悬浮条需要悬浮窗权限（不是输入法悬浮窗）"
            android:textSize="12sp"
            android:alpha="0.7" />

        <!-- Dropdown (Exposed) : Marker Style -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/ui_generating_content_marker_style">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/act_gen_marker_style"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Dropdown (Exposed) : Marker Color -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/ui_generating_content_marker_color">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/act_gen_marker_color"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/ui_generating_content_marker_rainbow_len"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/act_gen_marker_len"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ui_generating_content_marker_rainbow_speed" />

            <TextView
                android:id="@+id/tv_gen_marker_speed_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="70%" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_gen_marker_speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="100"
            android:stepSize="1"
            app:labelBehavior="withinBounds" />
        <!-- Dropdown (Exposed) : Completion Sound -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/ui_generating_content_complete_sound">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/act_gen_complete_sound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_gen_typing_sound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/ui_generating_content_typing_sound" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="打字声音样式">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/act_gen_typing_sound_style"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_ai_reply_vibrate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/ui_ai_reply_vibrate" />

        <TextView
            android:id="@+id/tv_vibrate_intensity_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/ui_ai_reply_vibrate_intensity" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_vibrate_intensity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="100"
            android:stepSize="1"
            app:labelBehavior="withinBounds" />

        <TextView
            android:id="@+id/tv_vibrate_frequency_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/ui_ai_reply_vibrate_frequency" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slider_vibrate_frequency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="100"
            android:stepSize="1"
            app:labelBehavior="withinBounds" />

    </LinearLayout>
</ScrollView>
